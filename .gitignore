# ==============================================================================
# FileZilla 3.71.1 — MSYS2 / mingw-w64 打包与改造仓库
#
# 入库（手工维护的输入）：
#   PKGBUILD、filezilla/（源码树，含 autoreconf 生成物）、patches/、BUILD-NOTES.md
#
# 忽略（可再生成的东西）：
#   构建目录、编译中间产物、二进制包、日志、临时脚本
#
# 注意：FileZilla 源码树里 config/compile、config/install-sh、config/missing、
#       config/depcomp、config/ltmain.sh、config.h.in、Makefile.in 都是**上游跟踪的
#       源文件**，因此这里故意不忽略它们，避免以后把源码树放进仓库时被误伤。
# ==============================================================================

# ---------- MSYS2 / makepkg 工作目录与输出 ----------
# 源码树在 ./filezilla/，与下面这些 makepkg 目录无关；
# /src/ 和 /pkg/ 是 makepkg 在仓库根目录跑出来的 srcdir/pkgdir（-C 会整个删掉它们）
/src/
/pkg/
# 旧的打包工作目录（源码已移入 ./filezilla/）
/build/
# PKGBUILD 的 build() 用的是 build-${MSYSTEM} 目录
build-*/

# ---------- 二进制包与源码包 （makepkg 产物，可由 source=() 重建） ----------
/dist/
*.pkg.tar
*.pkg.tar.*
*.src.tar
*.src.tar.*
*.pkg.tar.*.sig
*.pkg.tar.*.sha256

# ---------- 下载的源码压缩包 ----------
/*.tar.xz
/*.tar.gz
/*.tar.zst
/*.tar.bz2
/*.zip

# ---------- 编译产物（万一在源码树里就地构建） ----------
*.o
*.lo
*.la
*.a
*.dll
*.dll.a
*.lib
*.exe
*.exp
*.obj
*.pdb
*.ilk
.deps/
.libs/
stamp-h1
config.log
config.status
config.h
libtool
autom4te.cache/

# 上游源码树里自带的二进制资源（NSIS 安装脚本与 UAC 提权用），必须入库
!/filezilla/data/*.dll

# ---------- 日志 ----------
*.log

# ---------- 补丁残留 ----------
*.orig
*.rej
*.bak
*.patch.orig

# ---------- 临时脚本 / 中间报告（含本机绝对路径，不入库） ----------
/_work/
/.tmp/
/.cache/

# ---------- 编辑器 / 操作系统杂项 ----------
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
